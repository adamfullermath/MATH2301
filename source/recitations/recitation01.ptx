<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Recitation 1</title>

  <introduction>
    <p>
      <alert>Instructions: fill in the appropriate answers in the spaces based on the figure below. If there is no answer, write <sq>DNE</sq></alert>.
    </p>

    <p>
        Clearly write first and last names of each member on the top of the pages.
    </p>
  </introduction>

  <page>
    <exercise workspace="1in">
        
      <statement>
        <p>
          Fill in the answers for the limit, left limit, right limit, and value for the function <m>f(x)</m> for <m>x = -1,0,1,2,3</m>.
        </p>

              <figure xml:id="fig1" width="50%">
            <caption>Graph of <m>f(x)</m></caption>
            <image width="75%">
                <shortdescription>Plot of a piecewise defined function.</shortdescription>
                
            <sageplot label="fig1">
                rad = 0.03
                f = 4 - x^2
                g = -x + 3

                plt1 = plot(f,(-2,-rad), gridlines='major')
                plt2 = plot(f,(rad,1))
                plt3 = plot(g,(1+rad,2-rad))
                plt4 = plot(g,(2+rad,3.5))

                pt1 = circle((0,4),rad)
                pt2 = circle((0,1),rad,fill=True)
                pt3 = circle((1,3),rad, fill=True)
                pt4 = circle((1,2),rad)
                pt5 = circle((2,1),rad)

                plt = plt1 + plt2 + plt3 + plt4 + pt1 + pt2 + pt3 + pt4 + pt5

                plt
            </sageplot>
            </image>
        </figure>

        <md>
        <mrow>  \lim_{x\rightarrow -1}f(x) = <fillin characters="1" />; \, 
        \amp \lim_{x\rightarrow -1^{-}}f(x) = <fillin characters="1" />; \, 
        \lim_{x\rightarrow -1^{+}}f(x) = <fillin characters="1" />; \, 
        f(-1) = <fillin characters="1" />.
        </mrow>

        <mrow>  \lim_{x\rightarrow 0}f(x) = <fillin characters="1" />; \, 
        \amp \lim_{x\rightarrow 0^{-}}f(x) = <fillin characters="1" />; \, 
        \lim_{x\rightarrow 0^{+}}f(x) = <fillin characters="1" />; \, 
        f(0) = <fillin characters="1" />.
        </mrow>

        <mrow>  \lim_{x\rightarrow 1}f(x) = <fillin characters="1" />; \, 
        \amp \lim_{x\rightarrow 1^{-}}f(x) = <fillin characters="1" />; \, 
        \lim_{x\rightarrow 1^{+}}f(x) = <fillin characters="1" />; \, 
        f(1) = <fillin characters="1" />.
        </mrow>

        <mrow>  \lim_{x\rightarrow 2}f(x) = <fillin characters="1" />; \, 
        \amp \lim_{x\rightarrow 2^{-}}f(x) = <fillin characters="1" />; \, 
        \lim_{x\rightarrow 2^{+}}f(x) = <fillin characters="1" />; \, 
        f(2) = <fillin characters="1" />.
        </mrow>

        <mrow>  \lim_{x\rightarrow 3}f(x) = <fillin characters="1" />; \, 
        \amp \lim_{x\rightarrow 3^{-}}f(x) = <fillin characters="1" />; \, 
        \lim_{x\rightarrow 3^{+}}f(x) = <fillin characters="1" />; \, 
        f(3) = <fillin characters="1" />.
        </mrow>
        </md>
        
      </statement>
    </exercise>

  </page>
</worksheet>